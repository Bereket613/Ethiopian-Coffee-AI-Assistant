# ==========================================================
# ETHIOPIAN COFFEE AI ASSISTANT - CONFIGURATION
# Copy this file to .env and adjust variables as required
# ==========================================================

# Path overrides (leave commented to use default relative paths)
# COFFEE_MODEL_PATH=models/coffee_leaf_disease_model.pth
# CHROMA_DB_PATH=vector_db

# Translation Settings
ENABLE_ONLINE_TRANSLATION=true

# Optional API Keys (for cloud LLM generation if enabled)
# HF_TOKEN=your_huggingface_token_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Hardware & Device ('cpu' or 'cuda')
# DEVICE=cpu
